{
  "name": "pravia",
  "version": "1.0.0",
  "private": true,
  "description": "Pravia - Marketplace de materiel technologique",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts && tsx scripts/import-content-translations.mts",
    "db:studio": "prisma studio",
    "db:reset": "prisma db push --force-reset && npm run db:seed",
    "setup": "prisma generate && prisma db push && npm run db:seed",
    "e2e": "node scripts/e2e.mjs",
    "seo": "node scripts/seo-check.mjs",
    "verify": "node scripts/e2e.mjs && node scripts/seo-check.mjs && node scripts/i18n-check.mjs",
    "schema:sqlserver": "node scripts/schema-sqlserver.mjs",
    "build:iis": "npm run sql:all && prisma generate --schema prisma/schema.sqlserver.prisma && next build && node scripts/package-iis.mjs && prisma generate",
    "predev": "prisma generate",
    "sql:schema": "npm run schema:sqlserver && prisma migrate diff --from-empty --to-schema prisma/schema.sqlserver.prisma --script -o dist-sql/pravia-schema.sql",
    "sql:data": "prisma generate && tsx scripts/export-sqlserver.mjs",
    "sql:all": "npm run sql:schema && npm run sql:migration && npm run sql:data && npm run sql:translations",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:translations": "tsx scripts/import-content-translations.mts",
    "responsive": "node scripts/responsive-check.mjs",
    "rtl:check": "node scripts/rtl-sweep.mjs --verifier",
    "sql:migration": "node scripts/gen-migration-i18n.mjs",
    "sql:translations": "tsx scripts/export-translations-sqlserver.mts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-mssql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.41.0",
    "next": "^16.3.4",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
