// FICHIER GENERE - NE PAS MODIFIER A LA MAIN
// Source : prisma/schema.prisma
// Regenerer avec : npm run schema:sqlserver
//
// Differences appliquees pour SQL Server :
//   - fournisseur sqlserver
//   - colonnes de texte long en NVARCHAR(MAX)
//   - index sur searchText retire (inutilisable par un LIKE '%...%')
//   - cascades en doublon converties en NoAction, nettoyage fait par le code

// Pravia - Marketplace de materiel technologique
// Schema de donnees complet : catalogue, comptes, panier, commandes, avis, CMS.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

// ---------------------------------------------------------------- Comptes

model User {
  id           String   @id @default(cuid()) @db.NVarChar(36)
  email        String   @unique @db.NVarChar(320)
  passwordHash String? // absent pour un compte cree par connexion externe
  name         String
  role         String   @default("CUSTOMER") @db.NVarChar(200) // CUSTOMER | ADMIN
  avatarColor  String   @default("#6366f1")
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accounts  Account[]
  addresses Address[]
  cartItems CartItem[]
  orders    Order[]
  reviews   Review[]
  wishlist  WishlistItem[]

  @@index([role])
}

/// Carnet d'adresses d'un compte. Meme forme que l'adresse portee par une
/// commande : prenom, nom, wilaya, commune. La boutique ne livrant qu'en
/// Algerie, il n'y a ni pays ni code postal a saisir.
model Address {
  id         String  @id @default(cuid()) @db.NVarChar(36)
  userId     String @db.NVarChar(36)
  label      String  @default("Domicile")
  firstName  String
  lastName   String
  wilayaCode Int
  commune    String
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ---------------------------------------------------------------- Catalogue

model Category {
  id          String  @id @default(cuid()) @db.NVarChar(36)
  name        String
  slug        String  @unique @db.NVarChar(200)
  icon        String  @default("package") // nom d'icone lucide
  description String?
  sortOrder   Int     @default(0)

  metaTitle       String?
  metaDescription String? @db.NVarChar(Max)
  ogImage         String?
  noIndex         Boolean @default(false)

  translations CategoryTranslation[]
  products     Product[]
}

model Brand {
  id       String    @id @default(cuid()) @db.NVarChar(36)
  name     String
  slug     String    @unique @db.NVarChar(200)
  accent   String    @default("#64748b")
  products Product[]
}

model Product {
  id             String  @id @default(cuid()) @db.NVarChar(36)
  slug           String  @unique @db.NVarChar(200)
  title          String
  subtitle       String?
  description    String @db.NVarChar(Max)
  price          Int // en centimes
  compareAtPrice Int? // prix barre, en centimes
  stock          Int     @default(0)
  sku            String  @unique @db.NVarChar(200)
  condition      String  @default("NEW") // NEW | REFURBISHED | SECOND_HAND
  minOrder       Int     @default(1)
  tradeAssurance Boolean @default(false)
  readyToShip    Boolean @default(true)
  featured       Boolean @default(false)
  active         Boolean @default(true)
  soldCount      Int     @default(0)
  storage        String? // 128GB, 512GB...
  color          String?
  carrier        String? // T-Mobile, SM-F936U1...
  /// Garantie exprimee en valeur et en unite : certains accessoires sont
  /// garantis quelques jours, d'autres plusieurs annees. Un seul champ en mois
  /// ne savait pas dire "2 jours".
  warrantyValue  Int     @default(12)
  warrantyUnit   String  @default("MONTH") // DAY | MONTH | YEAR

  // Referencement : vides, on retombe sur le titre et la description du produit.
  metaTitle       String?
  metaDescription String? @db.NVarChar(Max)
  ogImage         String?
  noIndex         Boolean @default(false)

  // Index de recherche : titre, marque, categorie et specs normalises
  // (minuscules, sans accents). Recalcule a chaque ecriture.
  searchText String @default("") @db.NVarChar(Max)

  categoryId String @db.NVarChar(36)
  brandId    String @db.NVarChar(36)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id])
  brand        Brand                @relation(fields: [brandId], references: [id])
  translations ProductTranslation[]
  variants     ProductVariant[]
  images       ProductImage[]
  specs        ProductSpec[]
  reviews      Review[]
  cartItems    CartItem[]
  orderItems   OrderItem[]
  wishlist     WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([active])
}

/// Declinaison d'un produit : une couleur, son visuel et son stock propre.
///
/// Une coque existe en plusieurs teintes, chacune avec sa photo et sa
/// disponibilite. Le prix est facultatif : renseigne, il remplace celui du
/// produit ; laisse vide, toutes les couleurs sont au meme prix, ce qui est le
/// cas courant.
model ProductVariant {
  id        String  @id @default(cuid()) @db.NVarChar(36)
  productId String @db.NVarChar(36)
  name      String @db.NVarChar(200)
  nameAr    String?
  /// Pastille affichee dans le selecteur, en notation hexadecimale.
  hex       String  @default("#000000")
  sku       String?
  stock     Int     @default(0)
  price     Int?
  imageUrl  String?
  sortOrder Int     @default(0)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, name])
  @@index([productId])
}

model ProductImage {
  id        String @id @default(cuid()) @db.NVarChar(36)
  productId String @db.NVarChar(36)
  url       String
  alt       String @default("")
  sortOrder Int    @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSpec {
  id        String @id @default(cuid()) @db.NVarChar(36)
  productId String @db.NVarChar(36)
  label     String
  value     String
  sortOrder Int    @default(0)

  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations ProductSpecTranslation[]

  @@index([productId])
}

// ---------------------------------------------------------------- Panier & souhaits

model CartItem {
  id        String   @id @default(cuid()) @db.NVarChar(36)
  userId    String @db.NVarChar(36)
  productId String @db.NVarChar(36)
  /// Couleur choisie, quand le produit se decline. Deux teintes du meme
  /// article forment deux lignes distinctes du panier.
  variantId String? @db.NVarChar(36)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid()) @db.NVarChar(36)
  userId    String @db.NVarChar(36)
  productId String @db.NVarChar(36)
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([userId, productId])
  @@index([userId])
}

// ---------------------------------------------------------------- Commandes

model Order {
  id     String @id @default(cuid()) @db.NVarChar(36)
  number String @unique @db.NVarChar(200)
  /// Nul pour un achat sans compte : le compte ne sert qu'a retrouver ses
  /// commandes plus tard, il n'est jamais exige pour commander.
  userId String? @db.NVarChar(36)
  status String  @default("PENDING") @db.NVarChar(200) // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED | REFUNDED

  subtotal Int
  shipping Int
  tax      Int
  total    Int

  /// Paiement en especes a la livraison, seul mode accepte. La colonne est
  /// conservee pour que la commande porte son mode de reglement, si un autre
  /// venait a etre propose.
  paymentMethod String @default("CASH")

  /// Adresse de livraison. Les noms de wilaya et de commune sont recopies
  /// plutot que references : une commune renommee ou un tarif revu ne doit pas
  /// reecrire l'historique des commandes deja passees.
  shipFirstName  String
  shipLastName   String
  shipWilayaCode Int
  shipWilaya     String
  shipCommune    String

  trackingNumber String?
  notes          String? @db.NVarChar(Max)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([shipWilayaCode])
}

model OrderItem {
  id        String  @id @default(cuid()) @db.NVarChar(36)
  orderId   String @db.NVarChar(36)
  productId String? @db.NVarChar(36)
  variantId String? @db.NVarChar(36)

  titleSnapshot String
  /// Couleur commandee, recopiee comme le titre et le prix : renommer une
  /// teinte ne doit pas reecrire les commandes deja passees.
  variantSnapshot String?
  priceSnapshot   Int
  imageSnapshot   String?
  quantity        Int

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId])
}

// ---------------------------------------------------------------- Avis

model Review {
  id        String   @id @default(cuid()) @db.NVarChar(36)
  productId String @db.NVarChar(36)
  userId    String @db.NVarChar(36)
  rating    Int
  title     String
  body      String @db.NVarChar(Max)
  status    String   @default("PUBLISHED") @db.NVarChar(200) // PENDING | PUBLISHED | REJECTED
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, userId])
  @@index([productId])
  @@index([status])
}

// ---------------------------------------------------------------- Reglages

model Setting {
  key   String @id @db.NVarChar(200)
  value String @db.NVarChar(Max)
}

// ---------------------------------------------------------------- Referencement

/// Metadonnees des pages editoriales, editables depuis le back-office.
/// Les produits et categories portent leurs propres champs SEO.
model SeoPage {
  id              String  @id @default(cuid()) @db.NVarChar(36)
  path            String  @unique @db.NVarChar(200) // "/", "/produits", "/aide"
  label           String
  metaTitle       String?
  metaDescription String? @db.NVarChar(Max)
  ogImage         String?
  noIndex         Boolean @default(false)
  changeFrequency String  @default("weekly")
  priority        Float   @default(0.5)
  inSitemap       Boolean @default(true)

  translations SeoPageTranslation[]
  updatedAt    DateTime             @updatedAt
}

// ------------------------------------------------------------------- Recherche

/// Journal des recherches : alimente les statistiques du back-office et met en
/// evidence les requetes sans resultat.
model SearchQuery {
  id         String   @id @default(cuid()) @db.NVarChar(36)
  term       String
  normalized String @db.NVarChar(200)
  results    Int
  createdAt  DateTime @default(now())

  @@index([normalized])
  @@index([createdAt])
}

/// Synonymes de recherche : "pc portable" doit trouver "ordinateur portable".
model SearchSynonym {
  id      String @id @default(cuid()) @db.NVarChar(36)
  term    String @unique @db.NVarChar(200) // forme normalisee saisie par l'internaute
  targets String // termes de remplacement, separes par des virgules
}

// ------------------------------------------------------------ Livraison

/// Wilaya algerienne, decoupage 2026 : 69 wilayas.
///
/// Le tarif de livraison se pilote ici, depuis le back-office. Il vaut pour
/// toutes les communes de la wilaya, sauf celles qui en definissent un.
model Wilaya {
  /// Code officiel (1 a 69). Sert de cle : il est stable et parlant.
  code        Int     @id
  name        String @db.NVarChar(200)
  nameAr      String
  shippingFee Int
  /// Une wilaya inactive n'est plus proposee a la commande, sans que
  /// l'historique des commandes deja livrees la-bas en soit affecte.
  active      Boolean @default(true)

  communes Commune[]

  @@index([name])
}

/// Commune, rattachee a sa wilaya.
model Commune {
  id         String @id @default(cuid()) @db.NVarChar(36)
  wilayaCode Int
  name       String @db.NVarChar(200)
  nameAr     String
  postCode   String
  /// Nul : le tarif de la wilaya s'applique. Renseigne : il le remplace.
  shippingFee Int?

  wilaya Wilaya @relation(fields: [wilayaCode], references: [code], onDelete: Cascade)

  @@unique([wilayaCode, name])
  @@index([wilayaCode])
  @@index([name])
}

// ------------------------------------------------------- Connexions externes

/// Compte chez un fournisseur d'identite, rattache a un utilisateur Pravia.
/// Un meme utilisateur peut en lier plusieurs : Google au bureau, Apple sur
/// mobile, etc. La suppression du compte Pravia emporte les liaisons.
model Account {
  id                String   @id @default(cuid()) @db.NVarChar(36)
  userId            String @db.NVarChar(36)
  provider          String @db.NVarChar(200) // google | microsoft | facebook | tiktok | apple
  providerAccountId String @db.NVarChar(36) // identifiant stable chez le fournisseur
  email             String? // tel que renvoye par le fournisseur, pour tracabilite
  displayName       String?
  avatarUrl         String?
  createdAt         DateTime @default(now())
  lastLoginAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider])
}

// ------------------------------------------------------------- Traductions

/// Traduction d'une fiche produit.
/// Les champs vides retombent sur la version de reference du produit : une
/// fiche partiellement traduite reste donc affichable.
model ProductTranslation {
  id        String @id @default(cuid()) @db.NVarChar(36)
  productId String @db.NVarChar(36)
  locale    String @db.NVarChar(200) // fr | en | ar

  title           String?
  subtitle        String?
  description     String? @db.NVarChar(Max)
  metaTitle       String?
  metaDescription String? @db.NVarChar(Max)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

/// Traduction d'une caracteristique technique.
/// Le libelle se traduit toujours ; la valeur seulement lorsqu'elle porte du
/// texte ("Vert", "Oui"), jamais lorsqu'elle est purement technique ("120 Hz").
model ProductSpecTranslation {
  id     String @id @default(cuid()) @db.NVarChar(36)
  specId String @db.NVarChar(36)
  locale String @db.NVarChar(200)

  label String?
  value String?

  spec ProductSpec @relation(fields: [specId], references: [id], onDelete: Cascade)

  @@unique([specId, locale])
  @@index([locale])
}

/// Traduction d'une categorie : nom affiche, accroche et metadonnees.
model CategoryTranslation {
  id         String @id @default(cuid()) @db.NVarChar(36)
  categoryId String @db.NVarChar(36)
  locale     String @db.NVarChar(200)

  name            String?
  description     String? @db.NVarChar(Max)
  metaTitle       String?
  metaDescription String? @db.NVarChar(Max)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

/// Traduction des metadonnees d'une page editoriale.
model SeoPageTranslation {
  id        String @id @default(cuid()) @db.NVarChar(36)
  seoPageId String @db.NVarChar(36)
  locale    String @db.NVarChar(200)

  metaTitle       String?
  metaDescription String? @db.NVarChar(Max)

  seoPage SeoPage @relation(fields: [seoPageId], references: [id], onDelete: Cascade)

  @@unique([seoPageId, locale])
  @@index([locale])
}
