DATABASE_URL="file:./prisma/dev.db"
AUTH_SECRET="change-me-with-a-long-random-string"

# --- Connexions externes (facultatives) --------------------------------------
# Un fournisseur sans identifiants n'affiche aucun bouton : renseignez ceux que
# vous voulez activer. URL de rappel a declarer chez chacun :
#   <NEXT_PUBLIC_SITE_URL>/api/auth/<fournisseur>/callback

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# "common" accepte comptes personnels et professionnels
MICROSOFT_TENANT="common"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# TikTok nomme son identifiant "client key"
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Apple : Services ID, equipe, identifiant de cle, et contenu du fichier .p8
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
