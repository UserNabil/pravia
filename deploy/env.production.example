# Configuration de production Pravia
# Copier en .env.production a cote de pravia-server.cjs, puis restreindre les
# droits du fichier (lecture pour le compte du pool d'applications uniquement).

# --- Base de donnees ---------------------------------------------------------
DATABASE_PROVIDER="sqlserver"

# Format Prisma pour SQL Server. Adapter serveur, instance, identifiants.
# encrypt=true chiffre la connexion ; trustServerCertificate=true accepte le
# certificat auto-signe d'une instance locale (a retirer avec un vrai certificat).
DATABASE_URL="sqlserver://192.168.1.140:1433;database=Pravia;user=pravia_app;password=REMPLACER;encrypt=true;trustServerCertificate=true"

# --- Securite ----------------------------------------------------------------
# Chaine aleatoire longue, propre a cette installation.
# Generation : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="REMPLACER-PAR-UNE-CHAINE-ALEATOIRE-LONGUE"

# --- Referencement -----------------------------------------------------------
# Doit correspondre exactement au domaine public, sinon les URL canoniques,
# le sitemap et les apercus sociaux pointent au mauvais endroit.
NEXT_PUBLIC_SITE_URL="https://pravia.my-officeapps.com"

NODE_ENV="production"

# --- Connexions externes (facultatives) --------------------------------------
# Laissez vide un fournisseur que vous n'activez pas : son bouton disparait.
# URL de rappel a declarer chez chacun :
#   https://pravia.my-officeapps.com/api/auth/<fournisseur>/callback

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT="common"

FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# La cle .p8 tient sur plusieurs lignes : conservez les sauts sous forme \n
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""
