<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuration IIS pour Pravia.

  IIS ne sait pas executer du JavaScript : il delegue a Node via le module
  HttpPlatformHandler, qui lance le processus, lui attribue un port libre
  (%HTTP_PLATFORM_PORT%) et relaie les requetes. IIS gere ainsi le demarrage,
  le redemarrage apres plantage et le recyclage du pool d'applications.

  Prerequis : HttpPlatformHandler v1.2 installe sur le serveur.
  https://www.iis.net/downloads/microsoft/httpplatformhandler
-->
<configuration>
  <system.webServer>

    <handlers>
      <!-- Toutes les requetes partent vers Node ; IIS ne sert aucun fichier
           directement, ce qui evite les incoherences de cache avec Next. -->
      <add name="httpPlatformHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"
           requireAccess="Script" />
    </handlers>

    <httpPlatform processPath="C:\Program Files\nodejs\node.exe"
                  arguments="&quot;.\pravia-server.cjs&quot;"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\pravia"
                  startupTimeLimit="120"
                  startupRetryCount="3"
                  requestTimeout="00:04:00"
                  forwardWindowsAuthToken="false">
      <environmentVariables>
        <!-- HttpPlatformHandler choisit le port ; Next l'ecoute via PORT. -->
        <environmentVariable name="PORT" value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="127.0.0.1" />
        <environmentVariable name="NODE_ENV" value="production" />
        <!-- Les secrets (base de donnees, cle de session) restent dans
             .env.production, charge par pravia-server.cjs : un seul fichier
             a proteger par ACL, jamais versionne. -->
      </environmentVariables>
    </httpPlatform>

    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
      </customHeaders>
    </httpProtocol>

    <security>
      <requestFiltering>
        <!-- Les Server Actions transportent des formulaires ; 12 Mo laissent
             de la marge au-dela de la limite applicative de 4 Mo. -->
        <requestLimits maxAllowedContentLength="12582912" />
        <hiddenSegments>
          <add segment=".env.production" />
          <add segment="logs" />
        </hiddenSegments>
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
